{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "version": "1.12",
  "description": "__MSG_extension_description__",
  "default_locale": "en",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extension_name__"
  },
  "options_page": "settings.html",

  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "favicon.png",
    "32": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "permissions": [
    "sidePanel",
    "alarms",
    "storage"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://*.workers.dev/*"
  ]
}